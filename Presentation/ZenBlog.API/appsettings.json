{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "http://localhost:3000,https://localhost:3000"
  },
  "JwtSettings": {
    "Issuer": "ZenBlogAPI",
    "Audience": "ZenBlogClient",
    "ExpiryMinutes": 60
  },
  "CloudinarySettings": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "AdminSeed": {
    "Enabled": false,
    "Username": "admin",
    "FirstName": "Site",
    "LastName": "Admin"
  },
  "LuckyPenny": {
    "LicenseKey": ""
  }
}
